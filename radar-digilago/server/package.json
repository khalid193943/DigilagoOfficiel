{
  "name": "@radar/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:admin:prod": "node dist/scripts/seed-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}